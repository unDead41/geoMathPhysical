    "script_source": "import assert from 'node:assert/strict';\nimport {ModuleProgress} from '../source/digital/dist/module-progress.mjs';\nconst values=new Map(),sent=[];\nlet serial=0;\nconst frame={postMessage:message=>sent.push(message)};\nconst controller=new ModuleProgress({storage:{getItem:key=>values.get(key)||null,setItem:(key,value)=>values.set(key,value)},token:()=>`audit-nonce-${++serial}`});\nconst open=()=>{controller.open(frame);assert.equal(controller.handleMessage({source:frame,data:{type:'geodecoder:module-ready',protocol:1}}),true);return sent.at(-1).session;};\nconst nonce=open();\nconst original={type:'geodecoder:module-progress',protocol:1,session:nonce,activity:'net',stage:'explanation',prediction:'Six faces',result:'First result',explanation:'Each original face closes the cube.',completed:true};\nconst send=(data,source=frame)=>controller.handleMessage({source,data});\nassert.equal(send(original,{}),false);\nassert.equal(send({...original,session:'old-nonce'}),false);\nassert.equal(send(original),true);\nassert.equal(send({...original,result:'Newer result'}),true);\nconst replayAccepted=send(original);\nconst replayRestoredOlderResult=controller.state.records[0].result==='First result';\nassert.equal(replayAccepted,true);assert.equal(replayRestoredOlderResult,true);\nconst unknownEnvelopeAccepted=send({...original,padding:'x'.repeat(65537)});\nassert.equal(unknownEnvelopeAccepted,true);\ncontroller.setAccount({id:'account-b',role:'student'});\nassert.equal(send(original),false);\nconst accountBRecords=controller.state.records.length;assert.equal(accountBRecords,0);\nopen();assert.equal(send(original),false);\nconst denied=new ModuleProgress({storage:{getItem(){throw Error('denied')},setItem(){throw Error('denied')}},token:()=> 'denied-storage-nonce'});\ndenied.open(frame);denied.handleMessage({source:frame,data:{type:'geodecoder:module-ready',protocol:1}});\nconst failedSaveAccepted=denied.handleMessage({source:frame,data:{...original,session:'denied-storage-nonce'}});\nassert.equal(failedSaveAccepted,true);assert.equal(denied.state.storageFailed,true);\nconsole.log(JSON.stringify({label:'SOURCE_CHARACTERIZATION_ONLY',source:'37bc2cd262cc0a54e8ee31339ea37471c1ecfda5',foreign_source_rejected:true,old_nonce_rejected:true,current_session_older_completed_payload_reaccepted:replayAccepted,replay_restored_older_result:replayRestoredOlderResult,unknown_padding_over_64KiB_accepted:unknownEnvelopeAccepted,old_actor_message_rejected:true,account_b_record_count:accountBRecords,old_nonce_after_reopen_rejected:true,storage_denied_handle_message_returned:failedSaveAccepted,storage_failed_flag:denied.state.storageFailed}));\n",
